---
import { localePath, t, type Locale } from '../i18n';
import { isLive } from '../lib/routes';
import { site } from '../lib/site';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const href = (p: string) => localePath(locale, p);

const legal = [
  { label: d.footer.privacy, path: '/privacy-policy/' },
  { label: d.footer.terms, path: '/terms-and-conditions/' },
].filter((l) => isLive(l.path));
---

<footer class="bg-brand-900 text-white/80">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo class="h-7 text-white" />
      <p class="mt-5 max-w-sm text-sm leading-relaxed">{d.footer.blurb}</p>
    </div>

    <div class="text-sm">
      <p class="font-semibold text-white">{d.footer.office}</p>
      <address class="mt-3 leading-relaxed not-italic">
        {site.address.map((line) => <span class="block">{line}</span>)}
      </address>
    </div>

    <div class="text-sm">
      <p class="font-semibold text-white">{d.footer.contact}</p>
      <ul class="mt-2 sm:mt-3 sm:space-y-1.5">
        <li><a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center hover:text-white hover:underline sm:min-h-0">{site.email}</a></li>
        <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="inline-flex min-h-11 items-center hover:text-white hover:underline sm:min-h-0">{site.phone}</a></li>
        <li><a href={site.linkedin} class="inline-flex min-h-11 items-center hover:text-white hover:underline sm:min-h-0" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={site.instagram} class="inline-flex min-h-11 items-center hover:text-white hover:underline sm:min-h-0" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href={site.playStore} class="inline-flex min-h-11 items-center hover:text-white hover:underline sm:min-h-0" target="_blank" rel="noopener">{d.common.getApp}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-page flex flex-col gap-3 py-5 text-xs text-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2020-{new Date().getFullYear()} {d.footer.rights}</p>
      {
        legal.length > 0 && (
          <div class="flex gap-5">
            {legal.map((l) => (
              <a href={href(l.path)} class="inline-flex min-h-11 items-center hover:text-white hover:underline sm:min-h-0">
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</footer>
