---
import { localePath, locales, t, type Locale } from '../i18n';
import { isLive } from '../lib/routes';
import { site } from '../lib/site';
import { solutions } from '../content/solutions';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  path: string; // unprefixed path of the current page
  switchPath?: string; // unprefixed target of the language switch
}
const { locale, path, switchPath = path } = Astro.props;
const d = t(locale).nav;
const href = (p: string) => localePath(locale, p);

type Item = { label: string; path: string; href: string; note?: string };
const link = (label: string, p: string, note?: string): Item => ({ label, path: p, href: href(p), note });

// Every entry is filtered by isLive, so the menu never links to a page that does not exist yet.
const groups = [
  {
    label: d.solutions,
    overview: link(d.allSolutions, '/solutions/'),
    items: solutions.map((s) => link(s.name[locale], `/solutions/${s.slug}/`, s.summary[locale])),
  },
  { label: d.eudr, overview: null, items: [link(d.eudr, '/eudr/')] },
  { label: d.impact, overview: null, items: [link(d.impact, '/impact/')] },
  {
    label: d.resources,
    overview: null,
    items: [link(d.caseStudies, '/case-studies/'), link(d.insights, '/insights/'), link(d.faq, '/faq/')],
  },
  { label: d.company, overview: null, items: [link(d.about, '/about/'), link(d.team, '/team/'), link(d.careers, '/career/'), link(d.life, '/life-at-pasarmikro/')] },
]
  .map((g) => ({ ...g, overview: g.overview && isLive(g.overview.path) ? g.overview : null, items: g.items.filter((i) => isLive(i.path)) }))
  .filter((g) => g.items.length > 0);

// A group with a single live page shows as a plain link instead of a one-item menu.
const isMenu = (g: (typeof groups)[number]) => g.items.length > 1 || g.overview;
const contactHref = isLive('/contact/') ? href('/contact/') : `mailto:${site.email}`;
const active = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---

<header class="sticky top-0 z-40 border-b border-line bg-white">
  <div class="container-page flex h-16 items-center justify-between gap-3 lg:h-[72px] lg:gap-6">
    <a href={href('/')} class="shrink-0 py-2 text-brand-600" aria-label="PasarMIKRO home">
      <Logo class="h-6 sm:h-7" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        groups.map((g, gi) =>
          isMenu(g) ? (
            <div class="relative" data-menu>
              <button
                type="button"
                class="flex items-center gap-1 rounded-control px-3 py-2 text-[15px] font-medium text-ink hover:text-brand-600 aria-expanded:text-brand-600"
                aria-expanded="false"
                aria-controls={`menu-${gi}`}
                data-menu-button
              >
                {g.label}
                <svg class="size-4 transition-transform in-aria-expanded:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M5.2 7.5a.75.75 0 0 1 1.06-.02L10 11.1l3.74-3.62a.75.75 0 1 1 1.04 1.08l-4.26 4.13a.75.75 0 0 1-1.04 0L5.22 8.56a.75.75 0 0 1-.02-1.06Z" />
                </svg>
              </button>
              <div
                id={`menu-${gi}`}
                hidden
                class:list={[
                  'absolute top-full left-0 mt-2 rounded-card border border-line bg-white p-2 shadow-xl shadow-ink/10',
                  g.items.length > 4 ? 'w-[40rem]' : 'w-64',
                ]}
              >
                <ul class:list={['grid gap-1', g.items.length > 4 && 'grid-cols-2']}>
                  {g.items.map((i) => (
                    <li>
                      <a href={i.href} class="block rounded-control px-3 py-2.5 hover:bg-mist" aria-current={path === i.path ? 'page' : undefined}>
                        <span class="block text-[15px] font-semibold text-ink">{i.label}</span>
                        {i.note && <span class="mt-0.5 block text-sm leading-snug text-muted">{i.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
                {g.overview && (
                  <a href={g.overview.href} class="mt-1 flex items-center justify-between rounded-control bg-mist px-3 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50">
                    {g.overview.label}
                  </a>
                )}
              </div>
            </div>
          ) : (
            <a
              href={g.items[0].href}
              aria-current={path === g.items[0].path ? 'page' : undefined}
              class:list={['rounded-control px-3 py-2 text-[15px] font-medium hover:text-brand-600', active(g.items[0].path) ? 'text-brand-600' : 'text-ink']}
            >
              {g.items[0].label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-2 lg:gap-4">
    <div role="group" aria-label={d.language} data-lang-switch data-same-page={switchPath === path ? '' : undefined} class="flex overflow-hidden rounded-control border border-line text-sm font-semibold">
      {
        locales.map((l) => (
          <a
            href={localePath(l, switchPath)}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? 'true' : undefined}
            class="grid h-11 min-w-11 place-items-center px-2 text-muted transition-colors hover:bg-mist hover:text-brand-600 aria-[current=true]:bg-brand-600 aria-[current=true]:text-white"
          >
            {l.toUpperCase()}
            <span class="sr-only">{t(l).langName}</span>
          </a>
        ))
      }
    </div>
    <a href={contactHref} class="btn-primary hidden lg:inline-flex">{d.contact}</a>

    <details class="lg:hidden" data-mobile-menu>
      <summary class="btn-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">{d.menu}</summary>
      <nav class="absolute inset-x-0 top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-line bg-white px-4 pt-2 pb-6 shadow-lg" aria-label="Main">
        <ul class="divide-y divide-line">
          {
            groups.map((g) =>
              isMenu(g) ? (
                <li class="py-3">
                  <p class="text-sm font-semibold text-muted">{g.label}</p>
                  <ul class="mt-1">
                    {[...(g.overview ? [g.overview] : []), ...g.items].map((i) => (
                      <li>
                        <a href={i.href} class="flex min-h-11 items-center font-medium aria-[current=page]:text-brand-600" aria-current={path === i.path ? 'page' : undefined}>
                          {i.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={g.items[0].href} class="flex min-h-12 items-center font-medium aria-[current=page]:text-brand-600" aria-current={path === g.items[0].path ? 'page' : undefined}>
                    {g.items[0].label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
        <a href={contactHref} class="btn-primary mt-4 w-full">{d.contact}</a>
      </nav>
    </details>
    </div>
  </div>
</header>

<script>
  import '../scripts/lang-switch';

  // Desktop dropdowns: click or Enter/Space toggles, Escape or a click outside closes.
  const menus = [...document.querySelectorAll<HTMLElement>('[data-menu]')];
  const setOpen = (menu: HTMLElement, open: boolean) => {
    menu.querySelector('[data-menu-button]')!.setAttribute('aria-expanded', String(open));
    menu.querySelector<HTMLElement>('[id^="menu-"]')!.hidden = !open;
  };
  for (const menu of menus) {
    menu.querySelector('[data-menu-button]')!.addEventListener('click', () => {
      const open = menu.querySelector('[data-menu-button]')!.getAttribute('aria-expanded') !== 'true';
      menus.forEach((m) => setOpen(m, m === menu && open));
    });
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-menu]')) menus.forEach((m) => setOpen(m, false));
  });

  // Escape closes whichever menu is open and returns focus to its toggle.
  const mobile = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const m of menus) {
      const button = m.querySelector<HTMLElement>('[data-menu-button]')!;
      if (button.getAttribute('aria-expanded') === 'true') {
        setOpen(m, false);
        button.focus();
      }
    }
    if (mobile?.open) {
      mobile.open = false;
      mobile.querySelector('summary')?.focus();
    }
  });
</script>
