// Ported from the live /eudr/ landing page (main:eudr/index.html): same markup and inline styles.
// Changes: platform statistics removed (owner), offer parts hidden after the deadline, form posts to /api/contact with Turnstile.
import { env } from 'cloudflare:workers';
import { t } from '../../i18n';
import baliWoman from '../../assets/img/eudr/bali-woman.jpg';
import coffeeHarvest from '../../assets/img/eudr/coffee-harvest.jpg';
import cocoaPole from '../../assets/img/eudr/cocoa-pole.jpg';
import baliFarmer from '../../assets/img/eudr/bali-farmer.jpg';
import coffeeHand from '../../assets/img/eudr/coffee-hand.jpg';

interface Props {
  offer: boolean;
  countdown: string;
}
const { offer, countdown } = Astro.props;
const f = t('en').form;
const errors = { ...f.errors, server: 'Something went wrong. Please try again or email hello@pasarmikro.id.', network: 'Something went wrong. Please try again or email hello@pasarmikro.id.' };
const sent = Astro.url.searchParams.get('sent') === '1';
const errorKind = Astro.url.searchParams.get('error') as keyof typeof errors | null;
const errorText = errorKind && errors[errorKind];
