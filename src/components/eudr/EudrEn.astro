ption value="processor">Processor</option><option value="eu-buyer">EU buyer</option></select></div></div><div style="display: flex; flex-wrap: wrap; gap: 16px"><div style="display: flex; flex-direction: column; gap: 6px; flex: 1 1 200px"><label for="f-email" style="font-size: 14px; font-weight: 600">Email</label><input id="f-email" name="email" type="email" required autocomplete="email" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #8A94A6; border-radius: 10px; background: #FFFFFF; min-height: 44px; box-sizing: border-box; width: 100%"></div><div style="display: flex; flex-direction: column; gap: 6px; flex: 1 1 160px"><label for="f-phone" style="font-size: 14px; font-weight: 600">WhatsApp / phone</label><input id="f-phone" name="phone" type="tel" required inputmode="numeric" autocomplete="tel" style="font: inherit; font-size: 16px; padding: 12px 14px; border: 1px solid #8A94A6; border-radius: 10px; background: #FFFFFF; min-height: 44px; box-sizing: border-box; width: 100%"></div></div><div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-language="en" data-theme="dark" data-size="flexible"></div>
<button id="eudr-submit" type="submit" style="font: inherit; font-weight: 800; font-size: 16px; background: #FDB022; color: #003143; border: 0; border-radius: 10px; padding: 15px; min-height: 48px; cursor: pointer">{offer ? 'Claim free consultation + setup' : 'Request a consultation'}</button><p style="font-size: 13px; color: #475467">{offer ? 'Sign up by 13 November 2026 to qualify. We reply within one working day.' : 'We reply within one working day.'}</p><p role="status" data-form-status data-state={sent ? 'ok' : errorText ? 'error' : undefined} hidden={!sent && !errorText}>{sent ? 'We have received your request. Our EUDR team will contact you within one working day.' : errorText}</p>
