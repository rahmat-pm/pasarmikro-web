---
// Shared <head> contents: SEO, social cards, structured data and analytics. Used by Base and the EUDR landing page.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localePath, locales, t, type Locale } from '../i18n';
import { site } from '../lib/site';
import defaultOg from '../assets/img/eudr/coffee-harvest.jpg';

export interface Props {
  locale: Locale;
  /** Unprefixed path of this page, e.g. `/about/`. Drives canonical and hreflang. */
  path: string;
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  /** Set false when this page has no counterpart in the other language. */
  translated?: boolean;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { locale, path, title, description, image = defaultOg, translated = true, jsonLd, noindex = false } = Astro.props;
const d = t(locale);
const fullTitle = path === '/' ? `${d.meta.siteName}: ${title}` : `${title} | ${d.meta.siteName}`;
const desc = description ?? d.meta.defaultDescription;
const canonical = new URL(localePath(locale, path), site.url).href;
const ogImage =
  typeof image === 'string' ? image : new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, site.url).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/apple-touch-icon.png`,
  email: site.email,
  sameAs: [site.linkedin, site.instagram, site.playStore],
};
const ld = [orgLd, ...(jsonLd ? [jsonLd].flat() : [])];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{translated && locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site.url).href} />)}
{translated && <link rel="alternate" hreflang="x-default" href={new URL(path, site.url).href} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#006386" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={d.meta.siteName} />
<meta property="og:locale" content={d.ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<script async src="https://analytics.ahrefs.com/analytics.js" data-key={site.ahrefsKey}></script>
<script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}></script>
<script is:inline define:vars={{ id: site.ga4 }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', id);
</script>
