---
import { env } from 'cloudflare:workers';
import { localePath, t, type Locale } from '../i18n';
import { isLive } from '../lib/routes';

interface Props {
  locale: Locale;
  source: 'contact' | 'eudr';
  /** Unprefixed path of the page the form is on; a no-JS submit returns here. */
  path: string;
  submitLabel?: string;
}
const { locale, source, path, submitLabel } = Astro.props;
const f = t(locale).form;

// After a no-JS submit the endpoint redirects back with ?sent=1 or ?error=<kind>.
const sent = Astro.url.searchParams.get('sent') === '1';
const errorKind = Astro.url.searchParams.get('error') as keyof typeof f.errors | null;
const errorText = errorKind && f.errors[errorKind];

const field = 'mt-1.5 block w-full rounded-control border border-field bg-white px-3.5 py-2.5 text-base text-ink focus:border-brand-600';
const label = 'block text-sm font-medium';
---

<form
  id="contact-form"
  method="post"
  action="/api/contact"
  class="grid gap-5 sm:grid-cols-2"
  data-ajax-form
  data-sending={f.sending}
  data-errors={JSON.stringify(f.errors)}
>
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="return_to" value={localePath(locale, path)} />

  <label class={label}>
    {f.name}
    <input name="name" required maxlength="120" autocomplete="name" class={field} />
  </label>
  <label class={label}>
    {source === 'eudr' ? f.company : f.companyOptional}
    <input name="company" required={source === 'eudr'} maxlength="200" autocomplete="organization" class={field} />
  </label>
  <label class={label}>
    {f.email}
    <input name="email" type="email" required maxlength="200" autocomplete="email" class={field} />
  </label>
  <label class={label}>
    {f.phone}
    <input name="phone" type="tel" maxlength="50" autocomplete="tel" class={field} />
  </label>

  {
    source === 'eudr' ? (
      <>
        <label class={label}>
          {f.commodity}
          <select name="commodity" required class={field}>
            {Object.entries(f.commodities).map(([value, text]) => (
              <option value={value}>{text}</option>
            ))}
          </select>
        </label>
        <label class={label}>
          {f.role}
          <select name="role" required class={field}>
            {Object.entries(f.roles).map(([value, text]) => (
              <option value={value}>{text}</option>
            ))}
          </select>
        </label>
      </>
    ) : (
      <label class:list={[label, 'sm:col-span-2']}>
        {f.message}
        <textarea name="message" required maxlength="5000" rows="5" placeholder={f.messageHint} class={field} />
      </label>
    )
  }

  <div class="sm:col-span-2">
    <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-language={locale} data-size="flexible"></div>
  </div>

  <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center">
    <button type="submit" class="btn-primary disabled:opacity-60">{submitLabel ?? f.send}</button>
    {
      isLive('/privacy-policy/') && (
        <p class="text-sm text-muted">
          {f.privacy} <a href={localePath(locale, '/privacy-policy/')} class="text-brand-600 underline">{f.privacyLink}</a>.
        </p>
      )
    }
  </div>

  <p
    role="status"
    data-form-status
    data-state={sent ? 'ok' : errorText ? 'error' : undefined}
    hidden={!sent && !errorText}
    class="rounded-control px-4 py-3 text-sm sm:col-span-2 data-[state=error]:bg-red-50 data-[state=error]:text-red-800 data-[state=ok]:bg-brand-50 data-[state=ok]:text-brand-800"
  >
    {sent ? f.sent : errorText}
  </p>
  <template data-sent-text>{f.sent}</template>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import '../scripts/ajax-form';
</script>
