---
// Teal page header shared by inner pages: the app's store-panel look (DESIGN.md motifs 1 to 3).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Mark from './Mark.astro';

interface Props {
  title: string;
  highlight?: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumb?: { label: string; href: string };
  compact?: boolean;
}
const { title, highlight, intro, image, imageAlt = '', crumb, compact = false } = Astro.props;
---

<section class="panel-teal relative overflow-hidden">
  <Mark class="absolute -right-28 -bottom-24 w-[34rem] text-white/[0.07] lg:w-[42rem]" />
  <div
    class:list={[
      'container-page relative grid items-center gap-10',
      compact ? 'py-10 md:py-12' : 'py-12 md:py-16 lg:py-20',
      image && 'lg:grid-cols-[1.1fr_1fr] lg:gap-14',
    ]}
  >
    <div>
      {
        crumb && (
          <a href={crumb.href} class="inline-flex min-h-11 items-center text-sm font-medium text-white/85 hover:text-white">
            {crumb.label}
          </a>
        )
      }
      <h1 class:list={['font-bold tracking-tight text-balance', compact ? 'text-3xl sm:text-4xl' : 'text-[2.25rem] leading-[1.1] sm:text-5xl']}>
        {title}
      </h1>
      {highlight && <p class="label-sun mt-4 text-lg">{highlight}</p>}
      {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90">{intro}</p>}
      <slot />
    </div>
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800, 1100]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full rounded-photo object-cover shadow-2xl shadow-brand-900/40"
        />
      )
    }
  </div>
</section>
